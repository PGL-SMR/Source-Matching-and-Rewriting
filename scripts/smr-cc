#!/bin/bash
# A C compiler that sends a translation unit through SMR when a pattern applies
# to it:
#
#   clang -E  ->  smr (SMR_PATS)  ->  cir-translate  ->  clang -O3 -c
#
# Use it as CC (or CMAKE_C_COMPILER) to build a program with the patterns in
# SMR_PATS applied. A unit where smr applies no rewrite and no global
# optimization is compiled by plain clang, so it is what clang gives and it
# follows the ABI of the machine. The CIR path does not on aarch64 (ClangIR
# has no sret there yet), so mixing its objects with clang's can crash.
# Anything that is not "compile one .c file" goes to clang unchanged, and a
# translation unit SMR cannot handle falls back to plain clang.
#
#   SMR_PATS     .pat files, separated by spaces
#   SMR_CC_ALL   set it to send every unit through the CIR path, with no
#                pattern too: the control of an evaluation of the CIR path
#                itself (fallbacks then use `clang -fclangir`)
#   SMR_CC_LOG   file that gets one line per translation unit
#   SMR_CC_CLANG the clang to use (default: clang)

CLANG=${SMR_CC_CLANG:-clang}
LOG=${SMR_CC_LOG:-/dev/null}

ORIGINAL=("$@")
frontend=()   # flags the preprocessor needs
backend=()    # flags for the last clang
source=
output=
compile=0

while [ $# -gt 0 ]; do
  case "$1" in
    -c) compile=1 ;;
    -o) output=$2; shift ;;
    -I|-D|-U|-include|-isystem|-idirafter) frontend+=("$1" "$2"); shift ;;
    -I*|-D*|-U*|-std=*|-isystem*|-include*) frontend+=("$1") ;;
    -MD|-MMD) frontend+=("$1") ;;
    -MF|-MT|-MQ) frontend+=("$1" "$2"); shift ;;
    -g*) ;;
    -*) backend+=("$1") ;;
    *.c) [ -n "$source" ] && source=MANY || source=$1 ;;
    *) source=OTHER ;;
  esac
  shift
done

if [ "$compile" != 1 ] || [ -z "$source" ] || [ "$source" = MANY ] || [ "$source" = OTHER ]; then
  exec "$CLANG" "${ORIGINAL[@]}"
fi
[ -n "$output" ] || output=$(basename "${source%.c}").o

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
name=$(basename "${source%.c}")

skip() {
  echo "SKIP $source" >> "$LOG"
  "$CLANG" "${ORIGINAL[@]}"
  exit $?
}

fallback() {
  echo "FALLBACK $source ($1)" >> "$LOG"
  if [ -n "$SMR_CC_ALL" ]; then
    "$CLANG" -fclangir "${ORIGINAL[@]}"
  else
    "$CLANG" "${ORIGINAL[@]}"
  fi
  exit $?
}

[ -n "$SMR_PATS" ] || [ -n "$SMR_CC_ALL" ] || skip

# Dependency flags only matter for the preprocessing, the rest of the flags
# only for the last step.
"$CLANG" -E -P "${frontend[@]}" "$source" -o "$work/$name.c" 2> "$work/err" ||
  { cat "$work/err" >&2; exit 1; }

# shellcheck disable=SC2086
smr "$work/$name.c" $SMR_PATS -o "$work/$name.mlir" > "$work/smr.log" 2>&1 ||
  fallback "smr failed"
[ -s "$work/$name.mlir" ] || fallback "smr wrote nothing"
[ -n "$SMR_CC_ALL" ] ||
  grep -q "Applying rewrite\|Applying optimization" "$work/smr.log" || skip

cir-translate --cir-to-llvmir "$work/$name.mlir" -o "$work/$name.cir.ll" 2> "$work/err" ||
  fallback "cir-translate failed"

# The data layout cir-translate writes is not the one of the target, and the
# backend rejects it. Without it clang uses the one of the target.
sed '/^target datalayout/d' "$work/$name.cir.ll" > "$work/$name.ll"

"$CLANG" -Wno-unused-command-line-argument "${backend[@]}" -c "$work/$name.ll" \
  -o "$output" 2> "$work/err" || fallback "clang failed on the LLVM IR"

rewrites=$(grep -c "Applying rewrite" "$work/smr.log")
echo "OK $source rewrites=$rewrites" >> "$LOG"
